generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Article {
    id         Int                 @id @default(autoincrement())
    title      String
    content    String
    image      String?
    author_id  String
    base_views Int                 @default(0)
    created_at DateTime            @default(now())
    updated_at DateTime            @default(now())
    category   CategoryOnArticle[]
    comment    Comment[]
    author     User                @relation(fields: [author_id], references: [id])

    @@map("article")
}

model Category {
    id         Int                 @id @default(autoincrement())
    name       String
    article    CategoryOnArticle[]
    created_at DateTime            @default(now())
    updated_at DateTime            @default(now())

    @@map("category")
}

model User {
    id                String                @id @default(uuid())
    email             String                @unique
    name              String                @map("username")
    password          String?
    authlogs          Session_audit_trail[]
    roles             String
    emailVerified     Boolean               @map("is_verify")
    verified_at       DateTime?
    image             String?
    createdAt         DateTime              @map("created_at") @default(now())
    updatedAt         DateTime              @map("updated_at") @default(now())
    comment           Comment[]
    article           Article[]
    verificationCodes VerificationCode[]
    sessions          Session[]
    accounts          Account[]

    @@map("user")
}

model Session {
    id        String   @id
    user      User     @relation(fields: [userId], references: [id])
    userId    String
    token     String   @unique
    expiresAt DateTime @db.Timestamptz(3)
    ipAddress String?
    userAgent String?
    createdAt DateTime @db.Timestamptz(3)
    updatedAt DateTime @db.Timestamptz(3)

    @@map("session")
}

model Session_audit_trail {
    id              Int      @id @default(autoincrement())
    admin_id        String
    event_type      String
    device_type     String
    ip_address      String
    success         Boolean
    failure_session String?
    created_at      DateTime @default(now())
    updated_at      DateTime @default(now())
    admin           User?    @relation(fields: [admin_id], references: [id])

    @@map("session_audit_trail")
}

model Account {
    id                    String    @id
    user                  User      @relation(fields: [userId], references: [id])
    userId                String
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
    refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
    scope                 String?
    idToken               String?
    password              String?
    createdAt             DateTime  @db.Timestamptz(3)
    updatedAt             DateTime  @db.Timestamptz(3)

    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime @db.Timestamptz(3)
    createdAt  DateTime @db.Timestamptz(3)
    updatedAt  DateTime @db.Timestamptz(3)

    @@map("verification")
}

model Comment {
    id         Int      @id @default(autoincrement())
    user_id    String
    article_id Int
    content    String
    created_at DateTime @default(now())
    updated_at DateTime @default(now())
    user       User     @relation(fields: [user_id], references: [id])
    article    Article  @relation(fields: [article_id], references: [id])

    @@map("comment")
}

model CategoryOnArticle {
    category_id Int
    article_id  Int
    created_at  DateTime  @default(now())
    updated_at  DateTime  @default(now())
    article     Article?  @relation(fields: [article_id], references: [id])
    category    Category? @relation(fields: [category_id], references: [id])

    @@id([category_id, article_id])
    @@map("category_on_article")
}

model VerificationCode {
    id         String   @id @default(uuid())
    code       String
    user_id    String
    created_at DateTime @default(now())
    expired_at DateTime @default(now())
    user       User     @relation(fields: [user_id], references: [id])

    @@map("verification_code")
}
